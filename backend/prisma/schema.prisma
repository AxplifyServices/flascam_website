  is_active                                                            Boolean                @default(true)
  is_email_verified                                                    Boolean                @default(false)
  last_login_at                                                        DateTime?              @db.Timestamptz(6)
  password_changed_at                                                  DateTime?              @db.Timestamptz(6)
  created_at                                                           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                                                           DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at                                                           DateTime?              @db.Timestamptz(6)
  regional_association_id                                              String?                @db.Uuid
  adherents_adherents_reviewed_by_user_idTousers                       adherents[]            @relation("adherents_reviewed_by_user_idTousers")
  adherents_adherents_submitted_by_user_idTousers                      adherents[]            @relation("adherents_submitted_by_user_idTousers")
  adherents_adherents_user_idTousers                                   adherents?             @relation("adherents_user_idTousers")
  audit_logs                                                           audit_logs[]
  contact_messages                                                     contact_messages[]
  marketplace_deals_marketplace_deals_buyer_user_idTousers             marketplace_deals[]    @relation("marketplace_deals_buyer_user_idTousers")
  marketplace_deals_marketplace_deals_seller_user_idTousers            marketplace_deals[]    @relation("marketplace_deals_seller_user_idTousers")
  marketplace_listings_marketplace_listings_owner_user_idTousers       marketplace_listings[] @relation("marketplace_listings_owner_user_idTousers")
  marketplace_listings_marketplace_listings_reviewed_by_user_idTousers marketplace_listings[] @relation("marketplace_listings_reviewed_by_user_idTousers")
  marketplace_offers                                                   marketplace_offers[]
  media_assets                                                         media_assets[]
  news_articles_news_articles_created_by_user_idTousers                news_articles[]        @relation("news_articles_created_by_user_idTousers")
  news_articles_news_articles_reviewed_by_user_idTousers               news_articles[]        @relation("news_articles_reviewed_by_user_idTousers")
  news_articles_news_articles_updated_by_user_idTousers                news_articles[]        @relation("news_articles_updated_by_user_idTousers")
  non_voting_adherents_non_voting_adherents_created_by_user_idTousers  non_voting_adherents[] @relation("non_voting_adherents_created_by_user_idTousers")
  non_voting_adherents_non_voting_adherents_reviewed_by_user_idTousers non_voting_adherents[] @relation("non_voting_adherents_reviewed_by_user_idTousers")
  non_voting_adherents_non_voting_adherents_user_idTousers             non_voting_adherents?  @relation("non_voting_adherents_user_idTousers")
  refresh_tokens                                                       refresh_tokens[]
  regional_associations                                                regional_associations? @relation(fields: [regional_association_id], references: [id], onUpdate: NoAction)
  roles                                                                roles                  @relation(fields: [role_id], references: [id], onUpdate: NoAction)
  videos_videos_created_by_user_idTousers                              videos[]               @relation("videos_created_by_user_idTousers")
  videos_videos_reviewed_by_user_idTousers                             videos[]               @relation("videos_reviewed_by_user_idTousers")
  videos_videos_updated_by_user_idTousers                              videos[]               @relation("videos_updated_by_user_idTousers")

  @@index([deleted_at])
  @@index([is_active])
  @@index([role_id])
  @@index([regional_association_id])
}

